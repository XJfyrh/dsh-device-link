{
  "name": "dsh-device-link",
  "version": "0.5.2",
  "type": "module",
  "description": "LAN device pairing, scoped task delegation and on-demand file and session access for DeepSeek Harness",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./client": "./dist/client.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/client.js",
    "dist/lib/*.js",
    "dist/lib/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "icon": "./icon.png",
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.check.json",
    "build": "node --import tsx scripts/clean-dist.ts && tsc && esbuild src/client.tsx --bundle --format=iife --outfile=dist/client.js",
    "test": "tsx --test --test-timeout=20000 test/*.test.ts",
    "test:e2e": "npm run build && node --env-file-if-exists=.env --import tsx scripts/e2e-two-instance.ts",
    "test:e2e:protocol": "npm run build && node --import tsx scripts/e2e-two-instance.ts --protocol-only",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "license": "MIT",
  "author": "XJfyrh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XJfyrh/dsh-device-link.git"
  },
  "homepage": "https://github.com/XJfyrh/dsh-device-link#readme",
  "bugs": {
    "url": "https://github.com/XJfyrh/dsh-device-link/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "plugin",
    "lan",
    "device-link"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
