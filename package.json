{
  "name": "dsh-device-link",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "TypeScript LAN device pairing, scoped collaboration and offline session references for DeepSeek Harness",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./dist/client.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "DESIGN.md"
  ],
  "icon": "./icon.svg",
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && esbuild src/client.tsx --bundle --format=iife --outfile=dist/client.js",
    "test": "tsx --test --test-timeout=20000 test/*.test.ts",
    "test:e2e": "npm run build && node --env-file-if-exists=.env --import tsx scripts/e2e-two-instance.ts",
    "prepack": "npm run build"
  }
}
